rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || !isAuthenticated();
    }

    // Car catalog presets
    match /cars/{carId} {
      allow read: if true;
      allow write: if true;
    }

    // User uploaded car images
    match /userCarUploads/{uploadId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Customization options (paints, wheels, aero)
    match /customizationOptions/{optionId} {
      allow read: if true;
      allow write: if true;
    }

    // Car Builds
    match /builds/{buildId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Saved Builds (User Garage Favorites)
    match /savedBuilds/{savedId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
    }

    // Community Posts
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Likes tracking
    match /likes/{likeId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
    }

    // Comments on builds
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Modification Shops directory
    match /modificationShops/{shopId} {
      allow read: if true;
      allow write: if true;
    }

    // Performance & Cosmetic Parts Products
    match /partsProducts/{partId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

